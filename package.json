{
  "name": "@tio-canvas/canvas",
  "version": "0.3.0",
  "description": "A private exploration canvas: lay your project's pages out on an infinite board, frame real documents, annotate. Development tool, plain JavaScript, ships nothing to visitors.",
  "type": "module",
  "license": "MIT",
  "author": "Tio Putra",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiobedil/tio-canvas.git"
  },
  "homepage": "https://github.com/tiobedil/tio-canvas#readme",
  "bugs": {
    "url": "https://github.com/tiobedil/tio-canvas/issues"
  },
  "bin": {
    "tio-canvas": "./bin/tio-canvas.mjs"
  },
  "exports": {
    ".": "./src/index.js",
    "./server": "./src/server.js",
    "./build": "./src/build.js",
    "./project": "./src/project.js",
    "./thumbnails": "./src/thumbnails.js",
    "./client/*": "./client/*",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "client",
    "src",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node dev/serve.mjs",
    "test": "node tests/run.mjs"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "interface-kit": "0.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "semantic-release": "^24.2.9"
  }
}
