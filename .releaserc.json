{
  "branches": ["main"],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "releaseRules": [
          { "breaking": true, "release": "major" },
          { "header": "*!:*", "release": "major" },
          { "type": "feat", "release": "minor" },
          { "header": "*", "release": "patch" }
        ]
      }
    ],
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "npm version ${nextRelease.version} --no-git-tag-version && node scripts/stamp-changelog.mjs ${nextRelease.version}",
        "publishCmd": "npm publish --provenance --access public"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["client/changelog.js", "package.json"],
        "message": "chore(release): ${nextRelease.version} [skip ci]"
      }
    ],
    "@semantic-release/github"
  ]
}
